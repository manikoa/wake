{
  "name": "wake-sdk",
  "version": "0.1.0",
  "description": "Wake recorder SDK: records what every agent saw, said and did.",
  "license": "Apache-2.0",
  "author": "Anthony Maniko <117973652+manikoa@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manikoa/wake.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@12.15.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./a2a": {
      "types": "./dist/a2a.d.ts",
      "default": "./dist/a2a.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./quarantine": {
      "types": "./dist/quarantine.d.ts",
      "default": "./dist/quarantine.js"
    },
    "./flow": {
      "types": "./dist/flow.d.ts",
      "default": "./dist/flow.js"
    },
    "./aws": {
      "types": "./dist/aws.d.ts",
      "default": "./dist/aws.js"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "default": "./dist/langchain.js"
    },
    "./langgraph": {
      "types": "./dist/langgraph.d.ts",
      "default": "./dist/langgraph.js"
    },
    "./openai-agents": {
      "types": "./dist/openai-agents.d.ts",
      "default": "./dist/openai-agents.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/claude-agent-sdk.d.ts",
      "default": "./dist/claude-agent-sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "pnpm run build && node -e \"for (const f of ['LICENSE', 'NOTICE']) require('node:fs').copyFileSync('../../' + f, f)\""
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/otlp-transformer": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.300",
    "@langchain/core": ">=1.1.48",
    "@langchain/langgraph": ">=1.0.0",
    "@openai/agents": ">=0.21.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@anthropic-ai/sdk": "^1.3.0",
    "@langchain/core": "1.3.0",
    "@langchain/langgraph": "1.5.3",
    "@langchain/mcp-adapters": "2.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/agents": "0.21.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "express": "5.3.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
